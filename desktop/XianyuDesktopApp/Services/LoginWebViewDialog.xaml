<ContentDialog
    x:Class="XianyuDesktopApp.Services.LoginWebViewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:webview2="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="内嵌登录"
    PrimaryButtonText="取消"
    DefaultButton="Primary">
    <Grid Width="980" Height="820">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="12"
                CornerRadius="12"
                Background="{ThemeResource SecondaryGlassBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}"
                BorderThickness="1"
                Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <TextBlock x:Name="StatusTextBlock"
                           Text="请在下方完整页面中登录。检测到有效 Cookie 后将自动保存并关闭窗口。"
                           TextWrapping="WrapWholeWords"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock Text="如果页面显示不完整，请先最大化该窗口，或改用浏览器兜底登录。"
                           TextWrapping="WrapWholeWords"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>

        <webview2:WebView2 x:Name="LoginWebView"
                           Grid.Row="1"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />
    </Grid>
</ContentDialog>
