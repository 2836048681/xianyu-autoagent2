<Window
    x:Class="XianyuDesktopApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:XianyuDesktopApp.Controls"
    xmlns:models="using:XianyuDesktopApp.Models"
    mc:Ignorable="d"
    Title="Xianyu AutoAgent Desktop">
    <Border Background="{ThemeResource AppPageBackgroundBrush}">
        <Grid Margin="16"
              Background="{ThemeResource WindowSurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar"
                  Height="60"
                  Padding="18,0,8,0"
                  Background="{ThemeResource WindowSurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="17"
                            Background="{ThemeResource AccentSoftBrush}">
                        <SymbolIcon Symbol="Shop" Foreground="{ThemeResource AccentTextBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Xianyu AutoAgent"
                                   Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="Desktop workspace | Multi-account control | Live logs"
                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Button Style="{ThemeResource GlassButtonStyle}"
                            Content="Check updates"
                            Click="CheckUpdateButton_Click" />
                    <Button Style="{ThemeResource AccentGlassButtonStyle}"
                            Content="Add account"
                            Click="AddAccountButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Padding="0,14,0,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:GlassPanel Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Accounts" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                            <TextBlock Text="Up to 5 isolated account workspaces"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>

                        <ListView x:Name="AccountsListView"
                                  Grid.Row="1"
                                  Margin="0,16,0,0"
                                  IsItemClickEnabled="True"
                                  ItemClick="AccountsListView_ItemClick"
                                  SelectionMode="Single"
                                  ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AccountProfile">
                                    <Border Padding="14"
                                            CornerRadius="16"
                                            Background="{ThemeResource SecondaryGlassBrush}"
                                            BorderBrush="{ThemeResource CardStrokeBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource PrimaryTextBrush}" />
                                            <TextBlock Text="{x:Bind StatusText}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind CookieStatusText}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:GlassPanel>

                <controls:GlassPanel Grid.Column="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.SelectedAccountTitle, Mode=OneWay}"
                                       Style="{ThemeResource SectionTitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedAccountSummary, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <TabView Grid.Row="1" Margin="0,16,0,0">
                            <TabViewItem Header="Config">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="18" Padding="0,10,0,10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="API_KEY" Style="{ThemeResource FieldLabelTextBlockStyle}" />
                                            <TextBox Text="{x:Bind ViewModel.EditableAccount.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <TextBlock Text="MODEL_BASE_URL" Style="{ThemeResource FieldLabelTextBlockStyle}" />
                                            <TextBox Text="{x:Bind ViewModel.EditableAccount.ModelBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <TextBlock Text="MODEL_NAME" Style="{ThemeResource FieldLabelTextBlockStyle}" />
                                            <TextBox Text="{x:Bind ViewModel.EditableAccount.ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <TextBlock Text="COOKIES_STR" Style="{ThemeResource FieldLabelTextBlockStyle}" />
                                            <TextBox AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Height="220"
                                                     Text="{x:Bind ViewModel.EditableAccount.CookieString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Style="{ThemeResource AccentGlassButtonStyle}"
                                                    Content="Save config"
                                                    Click="SaveButton_Click" />
                                            <Button Style="{ThemeResource GlassButtonStyle}"
                                                    Content="Open prompts"
                                                    Click="OpenPromptsButton_Click" />
                                            <Button Style="{ThemeResource GlassButtonStyle}"
                                                    Content="Open account folder"
                                                    Click="OpenAccountFolderButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>

                            <TabViewItem Header="Run">
                                <StackPanel Spacing="18" Padding="0,10,0,10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Runtime status" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.RuntimeStatusText, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Style="{ThemeResource AccentGlassButtonStyle}"
                                                Content="Start account"
                                                Click="StartAccountButton_Click" />
                                        <Button Style="{ThemeResource GlassButtonStyle}"
                                                Content="Stop account"
                                                Click="StopAccountButton_Click" />
                                        <Button Style="{ThemeResource DangerGlassButtonStyle}"
                                                Content="Stop all"
                                                Click="StopAllButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </TabViewItem>

                            <TabViewItem Header="Login">
                                <StackPanel Spacing="18" Padding="0,10,0,10">
                                    <TextBlock Text="Use embedded WebView2 first. If the page is incomplete or cookies are not captured automatically, switch to fallback browser login."
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextWrapping="WrapWholeWords" />

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Style="{ThemeResource AccentGlassButtonStyle}"
                                                Content="Embedded login"
                                                Click="EmbeddedLoginButton_Click" />
                                        <Button Style="{ThemeResource GlassButtonStyle}"
                                                Content="Fallback browser login"
                                                Click="FallbackLoginButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </TabViewItem>

                            <TabViewItem Header="Logs">
                                <Grid Padding="0,10,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Runtime log" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.LogCaptionText, Mode=OneWay}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       TextWrapping="WrapWholeWords" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Style="{ThemeResource GlassButtonStyle}"
                                                    Content="Open log folder"
                                                    Click="OpenLogsButton_Click" />
                                            <Button Style="{ThemeResource GlassButtonStyle}"
                                                    Content="Copy logs"
                                                    Click="CopyLogsButton_Click" />
                                            <Button Style="{ThemeResource GlassButtonStyle}"
                                                    Content="Clear view"
                                                    Click="ClearLogsButton_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Margin="0,16,0,0"
                                            CornerRadius="18"
                                            Background="{ThemeResource LogSurfaceBrush}"
                                            BorderBrush="{ThemeResource CardStrokeBrush}"
                                            BorderThickness="1"
                                            Padding="18">
                                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="LogsTextBlock"
                                                       Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                                                       Foreground="{ThemeResource LogTextBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       TextWrapping="WrapWholeWords" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabViewItem>
                        </TabView>
                    </Grid>
                </controls:GlassPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
